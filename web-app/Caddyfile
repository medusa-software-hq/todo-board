{
	admin off
	# Cloud Run terminates TLS in front of this; a certificate here would be a second one nobody
	# asked for.
	auto_https off
}

:{$PORT} {
	encode gzip

	root * /srv
	# One page, many routes: anything that is not a file it has is the app itself.
	try_files {path} /index.html
	file_server
}
